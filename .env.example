# Copie para .env.local. Nunca commite credenciais.
# demo = catálogo de homologação local; supabase = banco como fonte.
CATALOG_SOURCE=demo
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legada, somente se o projeto não tiver chave publishable:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A aplicação desta fase NÃO precisa de chave privilegiada.
# As futuras rotinas de pedidos usarão uma destas apenas no servidor:
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# UUID da unidade de homologação definida no seed.sql:
STORE_ID=10000000-0000-4000-8000-000000000001
