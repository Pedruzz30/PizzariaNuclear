# Copie para .env.local. Nunca commite credenciais.
# demo = catálogo de homologação local; supabase = banco como fonte.
CATALOG_SOURCE=demo
# Para checkout, use uma URL HTTPS pública de preview. O Mercado Pago não aceita localhost nas URLs de retorno/webhook.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legada, somente se o projeto não tiver chave publishable:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Checkout usa uma destas apenas no servidor; nunca prefixe com NEXT_PUBLIC_:
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Apenas credenciais de TESTE do Mercado Pago, preenchidas localmente após configurar o preview HTTPS.
MERCADOPAGO_TEST_ACCESS_TOKEN=
MERCADOPAGO_TEST_WEBHOOK_SECRET=
# UUID da unidade de homologação definida no seed.sql:
STORE_ID=10000000-0000-4000-8000-000000000001
